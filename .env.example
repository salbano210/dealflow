# =============================================================================
# dealflow environment configuration
# =============================================================================
# Copy this file to .env and fill in your own values.
# .env is gitignored -- never commit real secrets.
#
# Setup:
#   cp .env.example .env
#   # then edit .env with your keys
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: OpenRouter API key
# -----------------------------------------------------------------------------
# Get yours at: https://openrouter.ai/keys
# Used for all LLM calls (extraction, scoring, etc.)
OPENROUTER_API_KEY=

# Optional: identifies your app to OpenRouter (shown in their dashboard)
OPENROUTER_APP_NAME=dealflow
OPENROUTER_APP_URL=https://github.com/salbano210/dealflow

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite database path (relative to repo root)
DEALFLOW_DB_PATH=data/dealflow.sqlite

# -----------------------------------------------------------------------------
# OPTIONAL: Airtable sync
# -----------------------------------------------------------------------------
# Create a base at https://airtable.com, then:
#   1. Get API key: https://airtable.com/create/tokens
#   2. Get Base ID: https://airtable.com/api (select your base, ID is in URL)
#   3. Create a table with fields matching config/airtable.yaml
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
