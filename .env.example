# Copy this file to .env and fill in your own values.
# .env is gitignored -- never commit real secrets.

# OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: identifies your app to OpenRouter (shown in their dashboard)
OPENROUTER_APP_NAME=jackryan
OPENROUTER_APP_URL=https://github.com/salbano210/jack_rAIn

# SQLite database path (relative to repo root)
JACKRYAN_DB_PATH=data/jackryan.sqlite

# Airtable (wired up in a later phase; leave blank for now)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
